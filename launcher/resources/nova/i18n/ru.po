msgid "Server has changed %1 authorization user hash in the reply. Something is wrong."
msgstr "Сервер вернул другой хэш пользователя %1. Что-то не так."

msgctxt "XboxAuthorizationStep"
msgid "Got authorization to access %1"
msgstr "Авторизация в %1 выполнена"

msgctxt "XboxAuthorizationStep"
msgid "Cannot parse %1 authorization error response as JSON: %2"
msgstr "Не удалось разобрать ошибку авторизации %1 как JSON: %2"

msgctxt "XboxAuthorizationStep"
msgid "XErr element is missing from %1 authorization error response."
msgstr "В ответе с ошибкой авторизации %1 нет элемента XErr."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account does not have an Xbox Live profile. Buy the game on %1 first."
msgstr "У этого аккаунта Microsoft нет профиля Xbox Live. Сначала купите игру на %1."

msgctxt "XboxAuthorizationStep"
msgid "Xbox Live is not available in your country. You've been blocked."
msgstr "Xbox Live недоступен в вашей стране."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account is underaged and is not linked to a family.\n\nPlease set up your account according to %1."
msgstr "Владелец этого аккаунта Microsoft несовершеннолетний, а аккаунт не добавлен в семью.\n\nНастройте его на %1."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account requires proof of age to play. Please login to %1 to provide proof of age."
msgstr "Для игры на этом аккаунте Microsoft нужно подтвердить возраст. Войдите на %1 и подтвердите его."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account has reached its limit for playtime. This Microsoft account has been blocked from logging in."
msgstr "На этом аккаунте Microsoft исчерпан лимит игрового времени, вход заблокирован."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account was banned by Xbox for violating one or more Community Standards for Xbox and is unable to be used."
msgstr "Этот аккаунт Microsoft заблокирован Xbox за нарушение правил сообщества и не может использоваться."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account is currently restricted and your guardian has not given you permission to play online. Login to %1 and have your guardian change your permissions."
msgstr "Этот аккаунт Microsoft ограничен: родитель или опекун не разрешил играть по сети. Войдите на %1 и попросите его поменять разрешения."

msgctxt "XboxAuthorizationStep"
msgid "This Microsoft account has not accepted Xbox's Terms of Service. Please login and accept them."
msgstr "На этом аккаунте Microsoft не приняты условия использования Xbox. Войдите и примите их."

msgctxt "XboxAuthorizationStep"
msgid "XSTS authentication ended with unrecognized error(s):\n\n%1"
msgstr "Вход XSTS завершился неизвестными ошибками:\n\n%1"

