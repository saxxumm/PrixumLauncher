msgctxt "RenderScalingWidget"
msgid "&Enable render scaling"
msgstr "&Включить масштабирование рендера"

msgctxt "RenderScalingWidget"
msgid "<b>gamescope was not found.</b> Render scaling needs it to upscale the game. Install it from your distribution's repositories (for example <code>sudo pacman -S gamescope</code>, <code>sudo apt install gamescope</code> or <code>sudo dnf install gamescope</code>), then press \"Check again\"."
msgstr "<b>gamescope не найден.</b> Он нужен, чтобы масштабировать игру. Установите его из репозиториев вашего дистрибутива (например, <code>sudo pacman -S gamescope</code>, <code>sudo apt install gamescope</code> или <code>sudo dnf install gamescope</code>) и нажмите «Проверить снова»."

msgctxt "RenderScalingWidget"
msgid "AMD FidelityFX Super Resolution (sharpened)"
msgstr "AMD FidelityFX Super Resolution (с повышением резкости)"

msgctxt "RenderScalingWidget"
msgid "Additional arguments that are passed to gamescope as is."
msgstr "Дополнительные аргументы, которые передаются gamescope как есть."

msgctxt "RenderScalingWidget"
msgid "Check again"
msgstr "Проверить снова"

msgctxt "RenderScalingWidget"
msgid "E&xtra gamescope arguments:"
msgstr "&Доп. аргументы gamescope:"

msgctxt "RenderScalingWidget"
msgid "Fill, crop the edges"
msgstr "Заполнить, обрезав края"

msgctxt "RenderScalingWidget"
msgid "Fit, keep aspect ratio"
msgstr "Вписать, сохраняя пропорции"

msgctxt "RenderScalingWidget"
msgid "Integer, pixel perfect multiples only"
msgstr "Целочисленно, только кратный масштаб"

msgctxt "RenderScalingWidget"
msgid "Lock the mouse &cursor to the game"
msgstr "Захватывать &курсор мыши в игре"

msgctxt "RenderScalingWidget"
msgid "NVIDIA Image Scaling (sharpened)"
msgstr "NVIDIA Image Scaling (с повышением резкости)"

msgctxt "RenderScalingWidget"
msgid "Passes --force-grab-cursor to gamescope. Without it the camera may spin when moving the mouse."
msgstr "Передаёт gamescope параметр --force-grab-cursor. Без него камера может вращаться при движении мыши."

msgctxt "RenderScalingWidget"
msgid "Render &Scaling"
msgstr "&Масштабирование рендера"

msgctxt "RenderScalingWidget"
msgid "Render &resolution:"
msgstr "&Разрешение рендера:"

msgctxt "RenderScalingWidget"
msgid "Render scaling relies on gamescope, which is only available on Linux."
msgstr "Масштабирование работает через gamescope, который есть только в Linux."

msgctxt "RenderScalingWidget"
msgid "Render the game at a lower resolution and upscale it to the window size. Use it to gain FPS on weak hardware or to get a chunky retro look. Choose a sharp filter for crisp pixels or a smooth one for a soft, blurred image."
msgstr "Игра рендерится в меньшем разрешении и растягивается до размера окна. Это поднимает FPS на слабом железе или даёт пиксельный ретро-вид. Выберите чёткий фильтр для резких пикселей или сглаживающий для мягкой, размытой картинки."

msgctxt "RenderScalingWidget"
msgid "S&harpness:"
msgstr "Р&езкость:"

msgctxt "RenderScalingWidget"
msgid "Scaling &mode:"
msgstr "Ре&жим масштабирования:"

msgctxt "RenderScalingWidget"
msgid "Sharp pixels: nearest neighbour, no blur"
msgstr "Чёткие пиксели: ближайший сосед, без размытия"

msgctxt "RenderScalingWidget"
msgid "Sharpening strength of FSR and NIS. Left is softer, right is sharper."
msgstr "Сила повышения резкости FSR и NIS. Левее — мягче, правее — резче."

msgctxt "RenderScalingWidget"
msgid "Smooth: bilinear, soft blur"
msgstr "Сглаживание: билинейный фильтр, мягкое размытие"

msgctxt "RenderScalingWidget"
msgid "Start in f&ullscreen"
msgstr "Запускать в &полноэкранном режиме"

msgctxt "RenderScalingWidget"
msgid "Stretch to fill the window"
msgstr "Растянуть на всё окно"

msgctxt "RenderScalingWidget"
msgid "The game renders at <b>%1 × %2</b> and is shown at %3 × %4."
msgstr "Игра рендерится в <b>%1 × %2</b> и выводится в %3 × %4."

msgctxt "RenderScalingWidget"
msgid "Tip: 50%, 33% or 25% keep every pixel the same size."
msgstr "Совет: при 50%, 33% или 25% все пиксели одного размера."

msgctxt "RenderScalingWidget"
msgid "Upscaling &filter:"
msgstr "&Фильтр масштабирования:"

msgctxt "RenderScalingWidget"
msgid "e.g. -r 60 --adaptive-sync"
msgstr "например, -r 60 --adaptive-sync"

msgctxt "RenderScalingWidget"
msgid "gamescope found: %1"
msgstr "gamescope найден: %1"

msgctxt "RenderScalingWidget"
msgid "gamescope opens in fullscreen and the screen resolution is used as the output size."
msgstr "gamescope откроется на весь экран, а выходным разрешением станет разрешение экрана."

